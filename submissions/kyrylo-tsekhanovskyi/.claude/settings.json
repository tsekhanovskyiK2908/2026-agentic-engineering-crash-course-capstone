{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Edit(./**)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git mv *)",
      "Bash(git add *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",

      "Bash(dotnet --version)",
      "Bash(dotnet --info)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet new *)",
      "Bash(dotnet sln *)",
      "Bash(dotnet add *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(dotnet run *)",
      "Bash(dotnet list *)",
      "Bash(dotnet ef *)",
      "Bash(dotnet tool restore)",

      "Bash(node --version)",
      "Bash(node scripts/*)",
      "Bash(npm --version)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "Bash(npx ng *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx playwright *)",
      "Bash(npx openapi-typescript *)",

      "Bash(openspec *)",
      "Bash(codex --version)",
      "Bash(codex exec review *)",

      "Bash(docker info *)",
      "Bash(docker version)",
      "Bash(docker ps *)",

      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet format *)",
      "PowerShell(npm run *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Service *)",
      "PowerShell(Get-NetTCPConnection *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(git config *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npx skills *)",
      "Bash(dotnet add * package *)",
      "Bash(dotnet remove * package *)",
      "Bash(docker run *)",
      "Bash(docker rm *)",
      "Bash(docker volume rm *)",
      "Edit(./.claude/settings.json)",
      "Edit(./.githooks/**)",
      "Edit(./.codex/**)"
    ],
    "deny": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(rm -rf *)",
      "PowerShell(git commit *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  }
}
