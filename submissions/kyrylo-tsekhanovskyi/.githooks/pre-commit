#!/bin/sh
# Universal commit gate for every tool and for humans. Installed by `npm run setup` (core.hooksPath).
# Runs the full check only when the commit touches the BOMKeeper submission folder.
# Note: the check runs on the working tree, so stage everything you have changed.
SUB="submissions/kyrylo-tsekhanovskyi/"
if git diff --cached --name-only | grep -q "^$SUB"; then
  echo "pre-commit: running npm run check for $SUB"
  cd "$(git rev-parse --show-toplevel)/$SUB" || exit 1
  node scripts/check.mjs all || {
    echo "pre-commit: check failed, commit blocked."
    exit 1
  }
fi
